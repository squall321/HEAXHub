Bootstrap: docker
From: node:20-slim

%files
    {{UPSTREAM_DIR}} /app

%post
    set -eux
    apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
    corepack enable
    # ── lockfile-tolerant pnpm install (STK-05) ──────────────────────────────
    # Honour package.json `packageManager` if present; else pin pnpm@9.15.0
    # (corepack default pulls pnpm@latest which needs Node 22+). Try a frozen
    # install for reproducibility, then fall back to --no-frozen-lockfile once
    # so a missing/version-mismatched lockfile degrades gracefully.
    cd /app
    if grep -q '"packageManager"' package.json 2>/dev/null; then
        corepack prepare --activate || corepack prepare pnpm@9.15.0 --activate
    else
        corepack prepare pnpm@9.15.0 --activate
    fi
    if [ -f pnpm-lock.yaml ]; then
        pnpm install --frozen-lockfile || {
            echo "WARN[STK-05]: frozen install failed; retrying --no-frozen-lockfile" >&2
            pnpm install --no-frozen-lockfile
        }
    else
        echo "WARN[STK-05]: no pnpm-lock.yaml; installing --no-frozen-lockfile" >&2
        pnpm install --no-frozen-lockfile
    fi
    # Next 는 basePath/assetPrefix 를 **빌드 시점에** HTML·청크 URL 에 굽는다. 런처가 주는
    # NEXT_PUBLIC_BASE_PATH 는 런타임이라 라우팅(308·200)만 맞고 자산은 루트 /_next/... 로
    # 나갔고, 프록시 아래에서 그 경로가 포털 SPA 로 떨어져 JS 자리에 HTML 이 반환됐다.
    # 앱은 항상 /apps/<app_id> 에 마운트되고 app_id 는 slug 의 '-' 를 '_' 로 바꾼 값이다.
    export NEXT_PUBLIC_BASE_PATH="/apps/$(printf '%s' '{{SLUG}}' | tr '-' '_')"
    echo "[heaxhub] building with NEXT_PUBLIC_BASE_PATH=$NEXT_PUBLIC_BASE_PATH"
    pnpm build

%environment
    export NODE_ENV=production
    export PATH=/usr/local/bin:$PATH

%runscript
    cd /app
    exec {{ENTRYPOINT}} "$@"

%help
    HEAXHub-managed Next.js SIF.
    slug: {{SLUG}}
    upstream commit: {{COMMIT}}
    subpath: {{SUBPATH}}
