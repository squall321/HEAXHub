.env.*.local

# Runtime data
app_workspaces/*
!app_workspaces/.gitkeep
job_storage/*
!job_storage/.gitkeep

# Logs
*.log
logs/

# Build artifacts
backend/dist/
frontend/dist/

# HEAXHub specific — keep secrets and large artifacts out
.env
backend/.env
var/
dist-bundle/
deploy/apptainer/.tools/
deploy/apptainer/cache/
deploy/apptainer/*.sif
infra/packages/deb/*.deb
infra/packages/npm/*.tgz
infra/packages/pip/*.whl
infra/packages/*.tar.*
*.log

# Build artifacts
frontend/dist/
backend/.venv/
agents/windows/bin/
agents/windows/obj/

# Tool caches
.koo-llm-sessions/
.bkit/
.playwright-mcp/

# Workspaces (per-app clones)
app_workspaces/
job_storage/
backend/celerybeat-schedule
# Build sentinels (run-time)
integrations/*/.heaxhub_build_ok
integrations/*/.venv/
integrations/*/node_modules/
integrations/*/.next/
integrations/*/dist/
var/integration_state/

# Demo build artifacts
integrations/heax-demo-go/heax-demo-go
integrations/heax-demo-go/bin/
integrations/heax-demo-cpp/bin/
integrations/heax-demo-cpp/output/
integrations/heax-demo-r/output/

# Pinned apptainer (project-local, not committed; built per-machine)
deploy/apptainer/.tools/
deploy/apptainer/cache/

# Per-demo SIF pipeline managed artifacts
var/local-demo-repos/
var/integration_workspaces/
var/sifs/

# 앱 런타임 데이터(영구 볼륨은 var/app_data/ — 소스 트리에 커밋 금지)
integrations/*/data/

# 운영서버 외부 연계(proxy) 앱 — register-external.sh 가 var/external-apps.yaml 에서
# 자동 생성. gitignore 라 update-all(git reset --hard)이 못 건드려 운영팀 등록분이 보존된다.
# (내 관리 앱과 라이프사이클 완전 분리 — 별도 apply 로만 갱신.)
integrations/ext_*/

# /data 이관 브리지(심링크) 이름 — dir/ 패턴은 심링크를 무시하지 않아 git stash -u 가 치운다(data-migration D0)
/var
/job_storage

# data-migrate 가 남기는 옛 경로 원본(유예 뒤 사람이 지운다). 미추적이면 deploy-all 의 git stash -u 가 치운다
*.pre-move-*
