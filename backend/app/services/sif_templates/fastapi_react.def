Bootstrap: docker
From: python:3.12-slim

%files
    {{UPSTREAM_DIR}} /app

%post
    set -eux
    # Hermetic Python: ignore the host user-site (~/.local) at build time so the
    # FULL runtime closure is installed into the image's system python
    # (/usr/local), not skipped because pip saw a copy under ~/.local. Apptainer
    # mounts $HOME at runtime, so ~/.local otherwise shadows the image's packages
    # on sys.path — a host env drift (e.g. a package major bump or a missing
    # transitive dep) then crashes the deployed app even though the SIF is intact.
    # Paired with the %environment export below, the container is fully hermetic.
    export PYTHONNOUSERSITE=1
    # Need Node 20 + pnpm for the Vite/React frontend build, and Python
    # tooling (already provided by python:3.12-slim) for the FastAPI backend.
    apt-get update
    apt-get install -y --no-install-recommends ca-certificates curl gnupg
    # NodeSource pins Node 20.x — matches the nextjs.def base and works with
    # corepack-prepared pnpm@9.15.0 (pnpm@latest needs Node 22+).
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
    apt-get install -y --no-install-recommends nodejs
    rm -rf /var/lib/apt/lists/*

    corepack enable

    # Stage 1: build the frontend → /app/frontend/dist/
    # ── lockfile-tolerant pnpm install (STK-05) ──────────────────────────────
    # Honour package.json `packageManager` if present; else pin pnpm@9.15.0.
    # Try frozen for reproducibility, fall back to --no-frozen-lockfile once.
    cd /app/frontend
    if grep -q '"packageManager"' package.json 2>/dev/null; then
        corepack prepare --activate || corepack prepare pnpm@9.15.0 --activate
    else
        corepack prepare pnpm@9.15.0 --activate
    fi
    if [ -f pnpm-lock.yaml ]; then
        pnpm install --frozen-lockfile || {
            echo "WARN[STK-05]: frozen install failed; retrying --no-frozen-lockfile" >&2
            pnpm install --no-frozen-lockfile
        }
    else
        echo "WARN[STK-05]: no pnpm-lock.yaml; installing --no-frozen-lockfile" >&2
        pnpm install --no-frozen-lockfile
    fi
    pnpm build

    # Stage 2: install the FastAPI backend (which serves /app/frontend/dist/
    # via StaticFiles at /). Editable install so app.main:app stays importable
    # the same way as the fastapi.def template.
    cd /app/backend
    pip install --no-cache-dir -e "{{PIP_TARGET}}"

    # Stage 3 (opt-in): app-provided container build hook. Runs
    # backend/scripts/heaxhub-build.sh (or scripts/heaxhub-build.sh) if the repo
    # ships one — for heavy/special deps kept OUT of pyproject (e.g.
    # voice_recorder installs torch + chatterbox-tts here because their GPU
    # build + install order can't live in the normal deps). Installs into the
    # container's system python (NOT a venv). No script ⇒ no-op (other apps
    # unaffected). Must be network-reachable at build time — build the fat SIF
    # on an ONLINE box, then ship it via dist-to-drive (per-app SIF).
    if [ -f /app/backend/scripts/heaxhub-build.sh ]; then
        echo "→ app container build hook: backend/scripts/heaxhub-build.sh"
        bash /app/backend/scripts/heaxhub-build.sh
    elif [ -f /app/scripts/heaxhub-build.sh ]; then
        echo "→ app container build hook: scripts/heaxhub-build.sh"
        bash /app/scripts/heaxhub-build.sh
    fi

%environment
    export PYTHONUNBUFFERED=1
    export NODE_ENV=production
    export PATH=/usr/local/bin:$PATH
    # Hermetic runtime: ignore the host user-site (~/.local) so the container uses
    # only its bundled packages. Apptainer mounts $HOME (even with --cleanenv), so
    # without this ~/.local shadows the image's site-packages on sys.path and a
    # host drift breaks the app. Survives --cleanenv (baked into the SIF env).
    export PYTHONNOUSERSITE=1

%runscript
    cd /app/backend
    exec {{ENTRYPOINT}} "$@"

%help
    HEAXHub-managed FastAPI + Vite/React (TS) fullstack SIF.
    Frontend built into /app/frontend/dist/ and mounted by FastAPI StaticFiles.
    Backend uvicorn served at /api/* and (catch-all) /.
    slug: {{SLUG}}
    upstream commit: {{COMMIT}}
    subpath: {{SUBPATH}}
